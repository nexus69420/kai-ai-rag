# Local zero-Docker defaults (PGlite file DB + on-disk vectors)
DATABASE_URL=pglite
QDRANT_URL=local

# Or use Docker Compose Postgres + Qdrant:
# DATABASE_URL=postgresql://kai:kai@localhost:5432/kai
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
# QDRANT_COLLECTION=kai_pdf_chunks_v1

# Optional server-side Gemini fallback (users can also set BYOK in Settings)
GOOGLE_API_KEY=

RATE_LIMIT_PER_MINUTE=30
