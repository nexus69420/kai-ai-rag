# ── Storage ───────────────────────────────────────────────────────────
# Local zero-Docker defaults (PGlite file DB + on-disk vectors)
DATABASE_URL=pglite
QDRANT_URL=local

# Or use Docker Compose Postgres + Qdrant:
# DATABASE_URL=postgresql://kai:kai@localhost:5432/kai
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
# QDRANT_COLLECTION=kai_pdf_chunks_v1

# Hosted (e.g. Vercel): set DATABASE_URL + QDRANT_URL + QDRANT_API_KEY +
# QDRANT_COLLECTION in the host dashboard — not for .env.local in git.
# Root directory for the Next app is apps/web.

# Where uploaded originals live: disk (default), tmp, or db (blob in Postgres).
# Serverless deploys are forced to db.
# KAI_PDF_STORAGE=disk

# ── Models ────────────────────────────────────────────────────────────
# Optional server-side Gemini fallback (users can also set BYOK in Settings)
GOOGLE_API_KEY=

# Additional keys for failover. Requests use the first key with quota left and
# advance to the next on a rate-limit error, which is what makes a full eval run
# (roughly 280 model calls) survive free-tier limits. Supports _2 through _10.
# GOOGLE_API_KEY_2=
# GOOGLE_API_KEY_3=
# Embedding model used by the seed and eval scripts.
# KAI_EMBEDDING_MODEL=gemini-embedding-001

RATE_LIMIT_PER_MINUTE=30

# ── Demo + evaluation ─────────────────────────────────────────────────
# Serve /api/demo, which attaches the browser session to the seeded corpus.
# KAI_ENABLE_DEMO=1
# KAI_DEMO_WORKSPACE_ID=kai-demo-workspace

# Let API callers pick a workspace with the x-guest-id header. Required by the
# eval harness when it talks to a running server; keep it off in production.
# KAI_ALLOW_GUEST_HEADER=0
